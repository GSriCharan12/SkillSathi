# SkillSathi Environment Configuration
# Copy this file to .env and adjust variables as needed

# Application
APP_NAME=SkillSathi
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=skillsathi_dev_secret_key_change_in_production_2026

# Backend Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (MySQL 8+)
# Set DATABASE_URL or component variables
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=skillsathi_db
MYSQL_USER=skillsathi_user
MYSQL_PASSWORD=skillsathi_password
DATABASE_URL=mysql+pymysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}?charset=utf8mb4

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# AI Provider Configuration (Provider Agnostic: gemini | openai | anthropic | ollama | mock)
AI_PROVIDER=mock
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini-1.5-flash
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048

# External Data Sync & Verification
DATA_SYNC_INTERVAL_HOURS=24
DATA_SYNC_ENABLE_AUTO=false
GOV_DATA_API_ENDPOINT=https://api.skillsathi.gov.in/v1/mock

# Regional Language & Voice (Future/Phase 2)
DEFAULT_LOCALE=en-IN
SUPPORTED_LOCALES=["en-IN","hi-IN","mr-IN","ta-IN","te-IN","bn-IN","gu-IN"]
